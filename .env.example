# Porta interna da aplicação
PORT=3000

# Porta exposta na VPS (3070 recomendada para evitar conflito com 3050 FakeDC e 3060 RealClima)
HOST_PORT=3070

# String de Conexão com MongoDB
# Na VPS rodando no host: mongodb://host.docker.internal:27017/3dcost ou mongodb://172.17.0.1:27017/3dcost
# Localmente: mongodb://127.0.0.1:27017/3dcost
MONGODB_URI=mongodb://host.docker.internal:27017/3dcost
